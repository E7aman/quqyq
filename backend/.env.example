# Скопируйте в .env и заполните. Файл .env НЕ коммитить (он в .gitignore).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
GEMINI_API_KEY=
# Если модель недоступна — смените на актуальную из ai.google.dev
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Лимит запросов с одного IP в минуту
RATE_LIMIT_PER_MIN=20
# 1 — записывать вопросы, оставшиеся без ответа (обезличенно), для пополнения базы
LOG_GAPS=0
